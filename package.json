{
  "name": "@rahuldrabit/eye-tracker",
  "version": "1.0.0",
  "description": "OpenGaze: High-precision, head-invariant web eye-tracking framework with in-situ online fine-tuning and zero-DOM Bayesian reading telemetry.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./core": {
      "import": "./dist/core/index.js",
      "types": "./dist/core/index.d.ts"
    },
    "./web": {
      "import": "./dist/web/index.js",
      "types": "./dist/web/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rahuldrabit/Eye_Tracker.git"
  },
  "keywords": [
    "eye-tracking",
    "gaze-estimation",
    "reading-telemetry",
    "computer-vision",
    "mediapipe",
    "one-euro-filter",
    "online-learning",
    "acm-etra",
    "webcam-gaze"
  ],
  "author": "Rahul Drabit",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Rahuldrabit/Eye_Tracker/issues"
  },
  "homepage": "https://github.com/Rahuldrabit/Eye_Tracker#readme",
  "scripts": {
    "test": "node --import jiti/register src/__tests__/run_all_tests.ts",
    "benchmark": "node --import jiti/register benchmarks/run_etra_benchmarks.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.18"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
